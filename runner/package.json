{
  "name": "ticket-test-harness-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')",
    "run": "tsx src/cli.ts",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "zod": "^3.23.0",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^20.11.0"
  }
}
